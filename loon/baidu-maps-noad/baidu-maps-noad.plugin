[MITM]
hostname = ecom.map.baidu.com, integralwall.baidu.com, afdconf.baidu.com, newclient.map.baidu.com, i.qchannel03.cn, nsclick.baidu.com, usr-api.yunxish.com, logrcv.yunxish.com
[Script]
http-response ^https?:\/\/newclient\.map\.baidu\.com\/(feed\/govui\/rich_content|cms\/page\/def) requires-body=true, script-path=baidu-maps-noad.js, tag=baidu-rich-content, timeout=10