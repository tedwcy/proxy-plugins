[MITM]
hostname = spclient.wg.spotify.com, *spclient.spotify.com
[Script]
http-response ^https:\/\/(spclient\.wg\.spotify\.com|.*-spclient\.spotify\.com(:443)?)\/color-lyrics\/v2\/track\/ script-path=https://raw.githubusercontent.com/tedwcy/proxy-plugins/main/loon/spotify-t2s/spotify-t2s.js, requires-body=true, binary-body-mode=true, timeout=10, tag=Spotify繁简转换
